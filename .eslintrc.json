{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2023,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "env": {
    "node": true,
    "es2023": true
  },
  "ignorePatterns": ["dist", "node_modules", "coverage", "*.config.js", "*.cjs"],
  "rules": {
    "no-console": "error",
    "eqeqeq": ["error", "smart"],
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/explicit-function-return-type": [
      "warn",
      {
        "allowExpressions": true,
        "allowTypedFunctionExpressions": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/*/src/domain/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/application/**",
                  "**/infrastructure/**",
                  "**/interface/**",
                  "../application/*",
                  "../infrastructure/*",
                  "../interface/*"
                ],
                "message": "Regra de dependência: domain não conhece nenhuma camada externa."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/*/src/application/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/infrastructure/**",
                  "**/interface/**",
                  "../infrastructure/*",
                  "../../infrastructure/*",
                  "../interface/*",
                  "../../interface/*"
                ],
                "message": "Regra de dependência: application depende de domain e de portas, nunca de adaptadores."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/tests/**/*.ts", "**/tests/**/*.tsx", "**/features/**/*.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/explicit-function-return-type": "off"
      }
    },
    {
      "files": ["apps/web/**/*.tsx", "apps/web/**/*.ts"],
      "env": {
        "browser": true
      }
    }
  ]
}
