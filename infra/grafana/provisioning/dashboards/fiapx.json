{
  "uid": "fiapx-overview",
  "title": "FIAP X — Processamento de vídeos",
  "tags": ["fiapx"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "video-api",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Vídeos recebidos",
      "description": "Fonte: video-api (videos_uploaded_total)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(videos_uploaded_total)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Latência HTTP da API (p95 por rota)",
      "description": "Fonte: video-api (http_request_duration_seconds_bucket)",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Uso de CPU (video-api)",
      "description": "Fonte: video-api (fiapx_api_process_cpu_seconds_total)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum(rate(fiapx_api_process_cpu_seconds_total[5m])) * 100",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Uso de memória (video-api)",
      "description": "Fonte: video-api (fiapx_api_process_resident_memory_bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "sum(fiapx_api_process_resident_memory_bytes)",
          "legendFormat": "rss",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "video-processor",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Vídeos concluídos",
      "description": "Fonte: video-processor (videos_processed_total)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "targets": [{ "expr": "sum(videos_processed_total)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Falhas",
      "description": "Fonte: video-processor (video_processing_failures_total)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 18 },
      "targets": [{ "expr": "sum(video_processing_failures_total)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Frames extraídos",
      "description": "Fonte: video-processor (frames_extracted_total)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 18 },
      "targets": [{ "expr": "sum(frames_extracted_total)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Vazão de processamento (vídeos/min)",
      "description": "Fonte: video-processor (videos_processed_total, video_processing_failures_total)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum(rate(videos_processed_total[5m])) * 60",
          "legendFormat": "concluídos",
          "refId": "A"
        },
        {
          "expr": "sum(rate(video_processing_failures_total[5m])) * 60",
          "legendFormat": "falhas",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Duração do processamento (p50 / p95)",
      "description": "Fonte: video-processor (video_processing_duration_seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(video_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(video_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Workers ativos",
      "description": "Fonte: video-processor (up{job=\"video-processor\"})",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "count(up{job=\"video-processor\"} == 1)",
          "legendFormat": "réplicas",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Uso de CPU (video-processor)",
      "description": "Fonte: video-processor (fiapx_processor_process_cpu_seconds_total)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 30 },
      "targets": [
        {
          "expr": "sum(rate(fiapx_processor_process_cpu_seconds_total[5m])) by (instance) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Uso de memória (video-processor)",
      "description": "Fonte: video-processor (fiapx_processor_process_resident_memory_bytes)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 30 },
      "targets": [
        {
          "expr": "fiapx_processor_process_resident_memory_bytes",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] }
    }
  ]
}
